{
  "buildCommand": "pnpm build",
  "trailingSlash": false,
  "cleanUrls": true,
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/calculator",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/graph",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tools",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/msea/(.*)",
      "destination": "/msea.html"
    },
    {
      "source": "/kms/(.*)",
      "destination": "/kms.html"
    },
    {
      "source": "/jms/(.*)",
      "destination": "/jms.html"
    },
    {
      "source": "/tms/(.*)",
      "destination": "/tms.html"
    },
    {
      "source": "/cms/(.*)",
      "destination": "/cms.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
